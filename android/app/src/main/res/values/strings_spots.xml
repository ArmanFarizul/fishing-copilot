<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Title of the Spots tab, which lists the user's saved fishing spots. -->
    <string name="spots_title">Your spots</string>
    <!-- Small badge on the home spot, the one the home screen cards use. Keep under 10 characters. -->
    <string name="spots_home_badge">Home</string>

    <!-- spots_add is the button on the Spots tab. It opens a full-screen map picker (same map, pins and list as onboarding step 4) titled spots_add_title, with spots_add_save and spots_add_cancel. -->
    <string name="spots_add">Add spot</string>
    <string name="spots_add_title">New spot</string>
    <string name="spots_add_save">Save</string>
    <string name="spots_add_cancel">Cancel</string>

    <!-- Two toggle chips under the Spots title: spots_view_list shows saved spots as a list, spots_view_map shows them on a map with a satellite layer (plankton, sea temperature, fronts, water clarity). Keep each under 10 characters. -->
    <string name="spots_view_list">List</string>
    <string name="spots_view_map">Map</string>

    <!-- Actions on each spot. Keep each under 18 characters. -->
    <string name="spots_set_home">Set as home</string>
    <string name="spots_rename">Rename</string>
    <string name="spots_delete">Delete</string>

    <!-- Rename dialog with one text field. -->
    <string name="spots_rename_title">Rename spot</string>
    <string name="spots_rename_label">Spot name</string>
    <string name="spots_rename_save">Save</string>
    <string name="spots_rename_cancel">Cancel</string>

    <!-- Delete confirmation dialog; %1$s is the spot name. The body explains that the spot's downloaded tide and weather data is removed, while catches logged there stay in the log without a spot. -->
    <string name="spots_delete_title">Delete %1$s?</string>
    <string name="spots_delete_body">Its downloaded tide and weather data will be removed. Catches logged here stay in your log, just without a spot.</string>
    <string name="spots_delete_confirm">Delete</string>
    <string name="spots_delete_cancel">Cancel</string>
    <!-- Shown when the user tries to delete the home spot, which is not allowed. -->
    <string name="spots_delete_home_blocked">This is your home spot. Set another spot as home first, then delete this one.</string>

    <!-- Snackbar after changing the home spot; %1$s is the spot name. -->
    <string name="spots_home_changed">%1$s is now your home spot.</string>
    <!-- Number of catches logged at this spot; %1$d is the count. -->
    <plurals name="spots_catch_count">
        <item quantity="one">%1$d catch</item>
        <item quantity="other">%1$d catches</item>
    </plurals>
</resources>
